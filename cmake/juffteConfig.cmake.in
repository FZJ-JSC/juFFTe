@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(OpenMP)
if(@WITH_MPI@)
    find_dependency(MPI COMPONENTS Fortran)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/juffteTargets.cmake")

check_required_components(juffte)
